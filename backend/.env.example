# Copie para .env e ajuste. Sem DATABASE_URL, a API usa PGlite (PostgreSQL embutido).
PORT=3333
HOST=0.0.0.0
# DATABASE_URL=postgresql://splitgo:splitgo@localhost:5432/splitgo
# PGLITE_DIR=./data/pglite

# Obrigatório em produção (NODE_ENV=production), mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT=10

# Leitor de recibos (Etapa 3). Sem ANTHROPIC_API_KEY, a leitura é simulada.
# ANTHROPIC_API_KEY=
# RECEIPT_PARSER=claude        # claude | mock (padrão: claude se houver chave)
# RECEIPT_MODEL=claude-opus-5-5
RECEIPT_MAX_MB=5
RECEIPT_RATE_LIMIT=20
