generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SplitMode {
  EQUAL
  CUSTOM
}

model User {
  id          String        @id @default(uuid()) @db.Uuid
  email       String        @unique
  name        String
  memberships GroupMember[]
  createdAt   DateTime      @default(now())
}

model Group {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  currency    String        @default("BRL") @db.Char(3)
  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
  createdAt   DateTime      @default(now())
}

// Participantes convidados podem existir sem conta; o ID do membro é a identidade contábil.
model GroupMember {
  id          String         @id @default(uuid()) @db.Uuid
  groupId     String         @db.Uuid
  userId      String?        @db.Uuid
  name        String
  email       String?
  archivedAt  DateTime?
  group       Group          @relation(fields: [groupId], references: [id], onDelete: Restrict)
  user        User?          @relation(fields: [userId], references: [id], onDelete: Restrict)
  expensesPaid Expense[]     @relation("Payer")
  shares      ExpenseShare[]
  sent        Settlement[]   @relation("Sender")
  received    Settlement[]   @relation("Recipient")

  @@unique([groupId, id])
  @@unique([groupId, userId])
}

model Expense {
  id          String         @id @default(uuid()) @db.Uuid
  groupId     String         @db.Uuid
  payerId     String         @db.Uuid
  description String
  totalCents  BigInt
  splitMode   SplitMode
  occurredAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())
  group       Group          @relation(fields: [groupId], references: [id], onDelete: Restrict)
  payer       GroupMember    @relation("Payer", fields: [groupId, payerId], references: [groupId, id], onDelete: Restrict)
  shares      ExpenseShare[]

  @@unique([groupId, id])
  @@index([groupId, occurredAt])
}

model ExpenseShare {
  groupId     String      @db.Uuid
  expenseId   String      @db.Uuid
  memberId    String      @db.Uuid
  amountCents BigInt
  expense     Expense     @relation(fields: [groupId, expenseId], references: [groupId, id], onDelete: Cascade)
  member      GroupMember @relation(fields: [groupId, memberId], references: [groupId, id], onDelete: Restrict)

  @@id([expenseId, memberId])
  @@index([groupId, memberId])
}

// Uma transferência sugerida só vira Settlement após confirmação de pagamento.
model Settlement {
  id             String      @id @default(uuid()) @db.Uuid
  groupId        String      @db.Uuid
  fromMemberId   String      @db.Uuid
  toMemberId     String      @db.Uuid
  amountCents    BigInt
  idempotencyKey String
  paidAt         DateTime    @default(now())
  group          Group       @relation(fields: [groupId], references: [id], onDelete: Restrict)
  sender         GroupMember @relation("Sender", fields: [groupId, fromMemberId], references: [groupId, id], onDelete: Restrict)
  recipient      GroupMember @relation("Recipient", fields: [groupId, toMemberId], references: [groupId, id], onDelete: Restrict)

  @@unique([groupId, idempotencyKey])
  @@index([groupId, paidAt])
}
